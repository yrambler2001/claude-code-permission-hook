  {"file": "deny-all", "expect": "none", "permission_mode": "default", "tool": "Write"},

  {"note": "allow-all: every prompt in every permission mode"},
  {"file": "allow-all", "expect": "allow", "permission_mode": "bypassPermissions", "tool": "Bash", "command": "cd sub && rm -f *"},
  {"file": "allow-all", "expect": "allow", "permission_mode": "auto", "tool": "Bash", "command": "rm -rf /tmp/x"},
  {"file": "allow-all", "expect": "allow", "permission_mode": "default", "tool": "Write"},
