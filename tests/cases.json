  {"note": "deny-all: every prompt in bypass sessions, nothing elsewhere"},
  {"file": "deny-all", "expect": "deny", "permission_mode": "bypassPermissions", "tool": "Bash", "command": "cd sub && rm -f *"},
  {"file": "deny-all", "expect": "deny", "permission_mode": "bypassPermissions", "tool": "Bash", "command": "ls"},
